{
  "name": "notes-app-backend",
  "version": "1.0.0",
  "description": "Notes App backend - Node.js, Express, MySQL (Sequelize), JWT auth, Pino logging",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test mocha test/**/*.test.js --timeout 10000 --exit",
    "test:coverage": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text mocha test/**/*.test.js --timeout 10000 --exit",
    "lint": "eslint src --ext .js",
    "db:migrate": "node src/config/syncDb.js"
  },
  "keywords": ["notes", "mern", "express", "mysql", "sequelize"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "mocha": "^10.6.0",
    "nodemon": "^3.1.4",
    "nyc": "^17.0.0",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0"
  }
}
